# archlinux Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
pkgname=sdl2-compat
pkgver=2.32.70
pkgrel=1
pkgdesc="An SDL2 compatibility layer that uses SDL3 behind the scenes"
url="https://github.com/libsdl-org/sdl2-compat"
depends=('sdl3')
makedepends=('cmake' 'ninja')
arch=('i686' 'x86_64')
conflicts=('sdl2')
#provides=("sdl2=${pkgver}")
#replaces=('sdl2')
license=('Zlib')
source=("https://github.com/libsdl-org/sdl2-compat/releases/download/release-${pkgver}/sdl2-compat-${pkgver}.tar.gz"{,.sig}
        '001-Msys-Cygwin-Likely-needed-changes.patch'
        '002-Cygwin-Mainly-thread-related-changes.patch'
        '003-Cygwin-warning-reduction.patch')
sha512sums=('477eff4b24dde48b8565406c636ffd5e9422700b28aec4bbb6165cbc30e8d95d0fe2c2400f8479c859ab82e8700370e2b5d6041721433ddb0064a1ec262a4af8'
            'SKIP'
            '9bf5ccd280da7eddbed10f6348e1cafa80018ae9fe67f95c732b0259e170a4e83711aefdaba1193a2fa11626a382209c23f70e8a1b70957dbae92eb6b953eed8'
            '63587efb2071bba8e969fd8f1833d077448689e4037c1d8753e8f3295f85c277ed858d9f23c9478b2999cf5943249ad85d2c704100ffa1a536df75447ee98a51'
            'bffdeb4e76cd6913d30150c15fbb7c4eb13bb0ecbebb883436d27b62719ed35f0384aba71a0bae28556aae3d79bc6622074ab55e247a7498ade6b7f51a103ad8')
validpgpkeys=('0900104363B4C9D4223DE149D913FE7D4B61D39B') # Sam Lantinga

prepare() {
  cd sdl2-compat-${pkgver}

  patch -p1 -i "${srcdir}"/001-Msys-Cygwin-Likely-needed-changes.patch
  patch -p1 -i "${srcdir}"/002-Cygwin-Mainly-thread-related-changes.patch
  patch -p1 -i "${srcdir}"/003-Cygwin-warning-reduction.patch
}

build() {
  [[ -d "build-${MSYSTEM_CARCH}" ]] && rm -rf "build-${MSYSTEM_CARCH}"
  mkdir -p "${srcdir}/build-${MSYSTEM_CARCH}"

  CFLAGS+=" -ffat-lto-objects"
  cmake -S sdl2-compat-$pkgver \
    -B build-${MSYSTEM_CARCH} \
    -G Ninja \
    -DCMAKE_INSTALL_PREFIX=${MSYSTEM_PREFIX} \
    -DSDL2COMPAT_X11=OFF \
    -DCMAKE_BUILD_TYPE=None

  cmake --build build-${MSYSTEM_CARCH}
}

check(){
  cd "${srcdir}/build-${MSYSTEM_CARCH}"

  ctest -VV # || test/testplatform || test/testver
}

package() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM_CARCH}
  cp build-${MSYSTEM_CARCH}/sdl2-compat.pc "${pkgdir}${MSYSTEM_PREFIX}/lib/pkgconfig/sdl2.pc"

  install -Dm644 "sdl2-compat-$pkgver/LICENSE.txt" "${pkgdir}${MSYSTEM_PREFIX}/share/licenses/$pkgname/LICENSE"
}
