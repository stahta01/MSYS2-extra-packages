        '004-Fix-selected-CYGWIN-build-issues.patch'
        '005-Msys-Work-around-fixes-for-IIDs.patch'
        '006-Add-support-for-MSYS.patch'
        '007-Cygwin-Add-__CYGWIN__-guard.patch'
        '008-Cygwin-Change-DLL-name.patch'
