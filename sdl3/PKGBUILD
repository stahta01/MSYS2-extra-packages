pkgname=sdl3
pkgver=3.4.14
pkgrel=2
pkgdesc="A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Version 3)"
arch=('i686' 'x86_64')
url="https://www.libsdl.org"
license=('Zlib')
depends=()
makedepends=('cmake' 'ninja' 'autotools' 'gcc')
source=("https://github.com/libsdl-org/SDL/releases/download/release-${pkgver}/SDL3-${pkgver}.tar.gz"{,.sig}
        '001-Msys-Work-around-fixes-for-IIDs.patch'
        '002-Fix-selected-CYGWIN-build-issues.patch'
        '003-Add-support-for-MSYS.patch')
sha512sums=('4105d57b3581d9d1e98c0bbd38d69cc5015b2b3d358fff0a617f9a89b37f5dd3e32e95b6ffc01cb865b9c599956cffa5cfcb96812fe7ed4afad632872c617e87'
            'SKIP'
            '8ed02a5d4809bef55d36cb41152e2621e5b4e34bd11318115bec11f76a3cabbe4621e2a981e1a23d4051e5d9c71cb412405443a909dafc644987c536a18d6b29'
            '524ac46c0ab3e7195481566998edf1193fae27460a6e77075d53c896d7fbd78e90da3ee2ac746440356724b9aaa9cbf7136acd440ac666b705fbd7438d7470e6'
            '5ece6b6e1bd21eabc6418045adf998459288ec16a2222a87824dc191cd947aa40a5553f710af90085457d66c599b0bd21044e9458ac60c29e7d22ff8d9d46947')
validpgpkeys=('1528635D8053A57F77D1E08630A59377A7763BE6') # Sam Lantinga

prepare() {
  cd SDL3-${pkgver}

  patch -p1 -i "${srcdir}"/001-Msys-Work-around-fixes-for-IIDs.patch
  patch -p1 -i "${srcdir}"/002-Fix-selected-CYGWIN-build-issues.patch
  patch -p1 -i "${srcdir}"/003-Add-support-for-MSYS.patch
}

build() {
  [[ -d "build-${MSYSTEM_CARCH}" ]] && rm -rf "build-${MSYSTEM_CARCH}"
  mkdir -p "${srcdir}/build-${MSYSTEM_CARCH}"
  cd "${srcdir}/build-${MSYSTEM_CARCH}"

  ${MSYSTEM_PREFIX}/bin/cmake.exe \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX=${MSYSTEM_PREFIX} \
    -DCMAKE_BUILD_TYPE=Release \
    ../SDL3-${pkgver}

  ${MSYSTEM_PREFIX}/bin/cmake --build .
}

check(){
  cd "${srcdir}/build-${MSYSTEM_CARCH}"

  ctest -VV || true
}

package() {
  cd "${srcdir}/build-${MSYSTEM_CARCH}"

  DESTDIR="${pkgdir}" ${MSYSTEM_PREFIX}/bin/cmake --install .

  install -Dm644 ../SDL3-${pkgver}/LICENSE.txt "$pkgdir${MSYSTEM_PREFIX}/share/licenses/$pkgname/LICENSE"
}

